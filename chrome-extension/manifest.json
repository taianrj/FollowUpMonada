{
  "manifest_version": 3,
  "name": "FollowUp Mônada — Integração WhatsApp Web",
  "version": "1.0.0",
  "description": "Consulta conversas e mantém transcrições no computador; envia à IA somente quando solicitado no Mônada.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "scripting",
    "alarms"
  ],
  "host_permissions": [
    "https://web.whatsapp.com/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "externally_connectable": {
    "matches": [
      "http://localhost/*",
      "http://127.0.0.1/*"
    ]
  },
  "background": {
    "service_worker": "background.mjs",
    "type": "module"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src http://localhost:3000 http://127.0.0.1:3000; media-src data: blob:; base-uri 'none'"
  },
  "key": ""
}
