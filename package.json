{
  "name": "followup-monada",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "extension:setup": "node scripts/setup-whatsapp-extension.mjs",
    "extension:baileys": "node scripts/setup-whatsapp-extension.mjs --baileys",
    "extension:package": "node scripts/package-whatsapp-extension.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "npm run test:web && npm run test:whatsapp-service && npm run test:whatsapp-poc && npm run test:whatsapp-extension",
    "test:whatsapp-extension": "node --test workers/whatsapp-extension/*.test.mjs",
    "test:whatsapp-poc": "node --test poc-chrome-whatsapp/*.test.js",
    "test:web": "vitest run",
    "test:whatsapp-service": "npm --prefix whatsapp-service test",
    "db:manage": "node scripts/database.cjs"
  },
  "dependencies": {
    "@google/genai": "^2.17.1",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.108.2",
    "bcryptjs": "^3.0.3",
    "next": "16.2.10",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "pg": "^8.23.1",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "postcss": "8.5.16"
  }
}
